{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenStudio Pro",
  "version": "0.0.1-alpha.1",
  "identifier": "com.zvirox.screenstudiopro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenStudio Pro",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
