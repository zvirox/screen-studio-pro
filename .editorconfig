# EditorConfig — https://editorconfig.org (AGENTS §3 code-style baseline)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs}]
# rustfmt governs; EditorConfig matches its defaults
indent_size = 4

[*.{md}]
# trailing spaces can be significant in Markdown (hard line breaks)
trim_trailing_whitespace = false
