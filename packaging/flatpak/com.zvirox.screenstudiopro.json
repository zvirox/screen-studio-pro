{
    "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
    "id": "com.zvirox.screenstudiopro",
    "runtime": "org.gnome.Platform",
    "runtime-version": "48",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable//24.08"
    ],
    "command": "screen-studio-pro",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=all",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--filesystem=xdg-videos"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "nasm",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz",
                    "sha256": "1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148"
                }
            ]
        },
        {
            "name": "x264",
            "buildsystem": "autotools",
            "config-opts": [
                "--enable-shared",
                "--disable-cli"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://code.videolan.org/videolan/x264.git",
                    "commit": "0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee"
                }
            ]
        },
        {
            "name": "ffmpeg",
            "buildsystem": "autotools",
            "config-opts": [
                "--enable-shared",
                "--disable-static",
                "--disable-doc",
                "--enable-gpl",
                "--enable-libx264"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-7.1.1.tar.xz",
                    "sha256": "733984395e0dbbe5c046abda2dc49a5544e7e0e1e2366bba849222ae9e3a03b1"
                }
            ]
        },
        {
            "name": "screen-studio-pro",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin"
            },
            "build-commands": [
                "cd src-tauri && cargo build --release",
                "install -Dm755 src-tauri/target/release/screen-studio-pro /app/bin/screen-studio-pro",
                "install -Dm644 packaging/flatpak/com.zvirox.screenstudiopro.desktop /app/share/applications/com.zvirox.screenstudiopro.desktop",
                "install -Dm644 packaging/flatpak/com.zvirox.screenstudiopro.metainfo.xml /app/share/metainfo/com.zvirox.screenstudiopro.metainfo.xml",
                "install -Dm644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/com.zvirox.screenstudiopro.png",
                "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/com.zvirox.screenstudiopro.png",
                "install -Dm644 src-tauri/icons/icon.png /app/share/icons/hicolor/512x512/apps/com.zvirox.screenstudiopro.png"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        ".git",
                        "node_modules",
                        "src-tauri/target",
                        ".flatpak-builder",
                        ".flatpak-repo"
                    ]
                }
            ]
        }
    ]
}
